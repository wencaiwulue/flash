{
  "name": "claude-code",
  "version": "1.0.0",
  "description": "Educational/research snapshot of Claude Code: an agentic coding CLI and TypeScript Agent SDK built with Bun, React, and Ink.",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "claude-code": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/entrypoints/agentSdkTypes.d.ts",
      "import": "./dist/sdk.mjs"
    },
    "./cli": "./dist/main.js"
  },
  "scripts": {
    "dev": "bun run --hot src/entrypoints/cli.tsx",
    "start": "bun run src/entrypoints/cli.tsx",
    "build": "bun scripts/build.ts && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --noEmit false --outDir dist/types",
    "generate:sdk-types": "bun scripts/generate-sdk-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test.ts"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@anthropic-ai/bedrock-sdk": "0.36.0",
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
